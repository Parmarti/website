# --- Required ---
DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Public URL of the app, no trailing slash. OAuth redirect URIs are built from it.
APP_URL="https://api.yourdomain.com"
# 32 random bytes as hex. Generate with: openssl rand -hex 32   (never change it after launch)
ENCRYPTION_KEY=""
# Secret for /api/cron/publish. Generate with: openssl rand -hex 24
CRON_SECRET=""
# Run the scheduler inside the web server (Railway, Render, Fly, Docker). Leave empty on Vercel.
RUN_SCHEDULER="1"
SUPPORT_EMAIL="support@yourdomain.com"

# --- Stripe billing ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_SCALE=""

# --- Shared developer apps (optional; customers can also bring their own in the dashboard) ---
# Redirect URI for each: {APP_URL}/api/connect/{platform}/callback
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
THREADS_CLIENT_ID=""
THREADS_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="web:yourapp:1.0 (by /u/yourredditname)"
# Optional shared Telegram bot. Users add it to their channel instead of creating their own bot.
TELEGRAM_BOT_TOKEN=""

# --- Optional overrides ---
# META_GRAPH_VERSION="v23.0"
# LINKEDIN_API_VERSION="202608"

# --- Development only. Never set in production: it turns off the block on private network URLs. ---
# ALLOW_PRIVATE_URLS="1"
